# Investor/Pass — environment variables
# Copy to .env and fill in. NEVER commit real secrets.

# Database (Supabase Postgres — pooler URL). The app auto-upgrades the
# session pooler (:5432) to the transaction pooler (:6543 + pgbouncer=true)
# for serverless safety — set IP_DB_SESSION_POOLER=1 to keep session mode.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Site
PUBLIC_SITE_URL=https://investorpass.vercel.app

# Prelaunch fail-safe: "true" hides the site from crawlers and enables the
# E2E-testable password-reset flow. Default (unset) is production behavior.
SITE_PRELAUNCH=false

# Payments (docs/payments-spec.md). "mock" keeps the demo checkout flow;
# "live" routes through the real processors.
PAYMENTS_MODE=mock
# Demo checkout grants Pro without payment — opt-in, pre-launch only.
MOCK_CHECKOUT_ENABLED=false
PAYMENT_VARIANT_MONTHLY=
PAYMENT_VARIANT_ANNUAL=
PAYMENT_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_ANNUAL=

# Google OAuth (Google Cloud console → Auth Platform → Clients)
# Redirect URI: {PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
