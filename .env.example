# Investor/Pass — environment variables
# Database (SQLite — relative path works locally and on Vercel if db file is committed)
DATABASE_URL=file:./db/custom.db
# Session signing secret
SESSION_SECRET=change-me-to-a-long-random-string
# Site
PUBLIC_SITE_URL=https://investor-pass.vercel.app
SITE_PRELAUNCH=false
# Payment provider (not required for V1 demo)
PAYMENT_VARIANT_MONTHLY=
PAYMENT_VARIANT_ANNUAL=
PAYMENT_WEBHOOK_SECRET=

# Payments (docs/payments-spec.md). PAYMENTS_MODE=mock keeps demo checkout; "live" routes processors.
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_ANNUAL=

# Google OAuth (Google Cloud console → Auth Platform → Clients)
# Redirect URI per deployment: {origin}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
