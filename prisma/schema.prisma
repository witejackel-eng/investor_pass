// Investor/Pass — Prisma schema
// SQLite-backed normalized relational model for the public record of exceptional investors.
// All text passages are paraphrased contextual summaries with source attribution — never
// fabricated quotes and never bulk reproduction of copyrighted works.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Identity, entitlement, subscription
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  // effective entitlement: "free" | "pro"
  // PAYWALL DORMANT — every user is Pro by default while the all-access
  // switch in src/lib/promo.ts returns true. To re-enable the paywall,
  // flip this default back to "free" and re-activate isAllAccess().
  entitlement   String   @default("pro")
  // "user" | "admin"
  role          String   @default("user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscription  Subscription?
  passwordResets PasswordResetToken[]
  bookmarks     Bookmark[]
  savedSearches SavedSearch[]
  collections   Collection[]
  sessions      Session[]
  passageProgress PassageProgress[]
  follows       Follow[]
  visitCursor   VisitCursor?
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  // state machine: "free" | "checkout_started" | "active" | "past_due" | "canceled" | "expired"
  state           String   @default("free")
  // "monthly" | "annual"
  variant         String?
  // "razorpay" | "paypal"
  provider        String?
  // processor subscription/payment id for webhook reconciliation
  providerRef     String?  @unique
  // effective entitlement resolved from state
  entitlement     String   @default("free")
  currentPeriodEnd DateTime?
  canceledAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Auth recovery: single-use password reset tokens ─────────────────────────
// Token is stored as sha256(token) — the raw token only ever exists in the
// email/link. One live token per user at a time (new request invalidates old).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Lightweight product analytics (spec §45–47). Append-only.
model SearchEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  props     String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// Core knowledge entities
// ────────────────────────────────────────────────────────────────────────────

model Person {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String?
  bio              String?
  // "buffett" | "munger" | "marks" | "lynch" | "bogle"
  status           String   @default("coming_later") // "active" | "coming_later"
  // Persona class: "investor" (Western capital allocators — Buffett/Munger/Marks…)
  // or "founder" (operating builders — Jack Ma, Mukesh Ambani, Ratan Tata…).
  // Drives the /founders surface and founder-branded detail pages.
  kind             String   @default("investor")
  // Geographic region for the founder collection: "us" | "china" | "india" | null.
  // Investors default to "us"; founders get "china" or "india" tagged by
  // scripts/ingest/tag-founders.ts after import.
  region           String?
  birthYear        Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sources          Source[]
  decisions        Decision[]
  personCompanies  PersonCompany[]
  personThemes     PersonTheme[]

  @@index([kind])
  @@index([region])
  @@index([kind, region])
}

model Source {
  id               String   @id @default(cuid())
  personId         String
  slug             String   @unique
  title            String
  // "shareholder_letter" | "annual_report" | "speech" | "interview" | "meeting_transcript" | "news" | "book"
  sourceType       String
  year             Int?
  publicationDate   String?
  publisher        String?
  url              String?
  description      String?
  // "verified" | "review" | "imported"
  provenanceStatus String   @default("verified")
  retrievalAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  person           Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  passages         Passage[]
  decisions        Decision[]
  relatedSourcesA  RelatedSource[] @relation("sourceA")
  relatedSourcesB  RelatedSource[] @relation("sourceB")

  @@index([personId])
  @@index([personId, year])
  @@index([year])
  @@index([sourceType])
}

model Passage {
  id          String   @id @default(cuid())
  sourceId    String
  // Paraphrased contextual summary. Never a verbatim copyrighted quote.
  text        String
  context     String?
  page        String?
  section     String?
  sequence    Int      @default(0)
  // "public" | "pro" — PAYWALL DORMANT: all passages default to public
  // while the all-access switch in src/lib/promo.ts returns true.
  // Existing pro-tier passages are also bulk-flipped to public via SQL.
  // To re-enable the paywall: flip default back to "pro", re-activate
  // isAllAccess(), and run UPDATE "Passage" SET visibility='pro' WHERE ...
  visibility  String   @default("public")
  // Master Plan §7/§9: "verified" | "provisional" | "needs_review" | "rejected"
  verificationState String @default("verified")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  source            Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  passageThemes     PassageTheme[]
  passageConcepts   PassageConcept[]
  passageCompanies  PassageCompany[]
  passageEvents     PassageEvent[]

  @@index([sourceId])
  @@index([sourceId, visibility])
  @@index([visibility])
}

model Theme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  passages    PassageTheme[]
  persons     PersonTheme[]
}

model Concept {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  passages    PassageConcept[]
}

model Company {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  canonicalName String?
  ticker        String?
  industryId    String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  industry      Industry?   @relation(fields: [industryId], references: [id])
  passages      PassageCompany[]
  persons       PersonCompany[]
  decisions     Decision[]

  @@index([industryId])
}

model Industry {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies   Company[]
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  date        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  passages    PassageEvent[]
  decisions   Decision[]
}

model Decision {
  id          String   @id @default(cuid())
  personId    String
  companyId   String?
  eventId     String?
  title       String
  date        String?
  description String?
  sourceId    String?
  // Decision Ledger extensions (Master Plan §19-20): statement → decision → outcome
  statement        String?
  action           String?
  outcome          String?
  outcomeSourceUrl String?
  decisionDate     String?
  // confidence: "high" | "medium" | "inferred"
  confidence       String?
  verified         Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id])
  event       Event?    @relation(fields: [eventId], references: [id])
  source      Source?   @relation(fields: [sourceId], references: [id])

  @@index([personId])
  @@index([companyId])
}

// ── Retention layer: reading continuity ──────────────────────────────────────
// One row per (user, passage) once the passage has been read ≥ dwell threshold.
model PassageProgress {
  userId    String
  passageId String
  sourceId  String?
  sequence  Int      @default(0)
  viewedAt  DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, passageId])
  @@index([userId, viewedAt(sort: Desc)])
}

// ── Retention layer: follow graph (free tier) ────────────────────────────────
// entityType: "person" | "topic" | "concept" | "company" | "event" | "source"
model Follow {
  id         String   @id @default(cuid())
  userId     String
  // "person" | "topic" | "concept" | "company" | "event" | "source" | "search"
  entityType String
  // slug/id for entities; savedSearch.id for kind "search"
  entityId   String
  // Denormalized display name for fast UI (owner spec §1)
  label      String?
  // Alert depth (Pro layer, Master Plan §3-5): "off" | "weekly" | "instant"
  alertFrequency String @default("weekly")
  createdAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
}

// ── Retention layer: new-since-last-visit cursor ─────────────────────────────
model VisitCursor {
  userId     String   @id
  lastSeenAt DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Retention layer: write-time notification fan-out ─────────────────────────
model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String
  url        String
  entityType String
  entityId   String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

// ────────────────────────────────────────────────────────────────────────────
// Junction tables (knowledge-graph relationships)
// ────────────────────────────────────────────────────────────────────────────

model PassageTheme {
  passageId String
  themeId   String

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([passageId, themeId])
  @@index([themeId])
}

model PassageConcept {
  passageId String
  conceptId String

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([passageId, conceptId])
  @@index([conceptId])
}

model PassageCompany {
  passageId String
  companyId String

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([passageId, companyId])
  @@index([companyId])
}

model PassageEvent {
  passageId String
  eventId   String

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([passageId, eventId])
  @@index([eventId])
}

model PersonCompany {
  personId  String
  companyId String

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([personId, companyId])
  @@index([companyId])
}

model PersonTheme {
  personId String
  themeId  String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([personId, themeId])
  @@index([themeId])
}

model RelatedSource {
  sourceAId String
  sourceBId String

  sourceA Source @relation("sourceA", fields: [sourceAId], references: [id], onDelete: Cascade)
  sourceB Source @relation("sourceB", fields: [sourceBId], references: [id], onDelete: Cascade)

  @@id([sourceAId, sourceBId])
}

// ────────────────────────────────────────────────────────────────────────────
// Pro user research artifacts
// ────────────────────────────────────────────────────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  // "source" | "passage" | "company" | "theme" | "search"
  kind      String
  entityId  String
  label     String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, entityId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  title     String
  query     String
  filters   String   // JSON-encoded filter object
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  // "passage" | "source" | "company" | "theme"
  kind         String
  entityId     String
  label        String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
}

// ────────────────────────────────────────────────────────────────────────────
// Knowledge-graph layer (Graphify model, applied to the investor corpus)
//
// Every entity in the database — investors, sources, passages, themes,
// concepts, companies, events, years, decisions — is materialized as a node,
// and every relationship as a typed edge with a confidence tag, mirroring
// graphify's graph.json format (id/label/kind + relation/confidence/weight).
// Communities (label propagation over the entity graph) and node weights
// (degree) power the "god node" ranking. The layer is fully derived data:
// rebuild it any time with `bun scripts/db/build-graph.ts`.
// ────────────────────────────────────────────────────────────────────────────

model GraphNode {
  id      String   @id // "person:buffett", "theme:compounding", "year:1988"
  kind    String // investor | source | passage | theme | concept | company | event | year | decision
  label   String
  slug    String?
  href    String? // deep link into the app
  weight  Int      @default(0) // degree — god-node ranking
  communityId Int?
  updatedAt DateTime @updatedAt

  edgesFrom GraphEdge[] @relation("graphEdgeFrom")
  edgesTo   GraphEdge[] @relation("graphEdgeTo")

  @@index([kind])
  @@index([communityId])
  @@index([weight])
}

model GraphEdge {
  id         String @id // md5(sourceId|targetId|relation) — deterministic, MERGE-safe
  sourceId   String
  targetId   String
  relation   String // WROTE | CONTAINS | TAGGED | COVERS | MENTIONS | REFERENCES | PUBLISHED_IN | DECIDED_ON | MADE | REGARDING | ASSOCIATED_WITH | FOCUSES_ON | SHARED_THEME | SHARED_COMPANY | RELATED_TO
  confidence String @default("EXTRACTED") // EXTRACTED | INFERRED
  weight     Int    @default(1)

  source GraphNode @relation("graphEdgeFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  target GraphNode @relation("graphEdgeTo", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relation])
  @@index([sourceId])
  @@index([targetId])
  @@index([relation])
}

// Investor↔investor relationships from the Corpus Research Map (lineage,
// apprenticeship, cohort, cluster, network) — consumed by the graph builder
// as STUDIES/LINEAGE edges. Seeded by scripts/ingest/import-corpus-map.ts.
model InvestorRelation {
  fromSlug String
  toSlug   String
  kind     String // apprenticeship | lineage | cohort | cluster | network
  reason   String

  @@id([fromSlug, toSlug, kind])
}

// Editorial trust layer (Master Plan §35-36, §10):
// reader-submitted corrections with a review state machine, and a public
// changelog of editorial changes.
model Correction {
  id          String    @id @default(cuid())
  // "passage" | "source" | "decision" | "company" | "theme" | "event"
  entityKind  String
  entityId    String
  // "factual" | "sourcing" | "attribution" | "tagging" | "duplicate" | "other"
  issueType   String
  message     String
  submitterEmail String?
  // "submitted" | "reviewed" | "corrected" | "rejected"
  state       String    @default("submitted")
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([entityKind, entityId])
  @@index([state, createdAt])
}

model Changelog {
  id        String   @id @default(cuid())
  date      String // "2026-08-23" display date
  title     String
  body      String // markdown-lite: paragraphs and +/- lines
  // "corpus" | "feature" | "editorial" | "fix"
  category  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Server-side application config (key/value). Used to bootstrap the session
// signing secret when SESSION_SECRET is absent from the environment —
// generated once, stored server-side only, never exposed via any API.
// (The Session table already persists raw tokens server-side, so keeping the
// signing key in the same database adds no new attack surface.)
model AppConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
